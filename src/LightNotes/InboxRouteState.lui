namespace LightNotes;
using Lucent.Core;

style CollapsedRouteStateStyle {
    Participation: ElementParticipation.Collapsed;
    Width: 0;
    Height: 0;
    MainGrow: 0;
}

internal component InboxRouteState() {
    context RouteContext<WorkspaceRoute> workspace;
    context RouteContext<InboxRoute> route;
    <Layout style={CollapsedRouteStateStyle} name={"notes.route." + workspace.Definition.Id.Value + "." + route.Definition.Id.Value}>
        {LightNotesRouting.Child()}
    </Layout>
}
