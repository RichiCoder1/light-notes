<Project Sdk="Microsoft.NET.Sdk;Lucent.Lui.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <RootNamespace>LightNotes</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="LightNotes.Tests" />
    <ProjectReference Include="../LightNotes.Storage/LightNotes.Storage.csproj" />
    <PackageReference Include="Lucent.Platform.Windows" Version="[$(LucentVersion)]" />
    <PackageReference Include="Lucent.Hosting" Version="[$(LucentVersion)]" />
    <PackageReference Include="Lucent.Reactive.R3" Version="[$(LucentVersion)]" />
    <PackageReference Include="Lucent.Icons.Lucide" Version="[$(LucentVersion)]" />
    <LucentAsset
      Include="Artwork/light-notes.svg"
      Path="application/light-notes.svg"
      ApplicationIcon="true"
    />
    <None
      Include="../../notices/*"
      Link="notices/%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
