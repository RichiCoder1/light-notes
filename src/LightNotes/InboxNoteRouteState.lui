namespace LightNotes;
using Lucent.Core;

style CollapsedRouteStateStyle {
    Participation: ElementParticipation.Collapsed;
    Width: 0;
    Height: 0;
    MainGrow: 0;
}

internal component InboxNoteRouteState() {
    context RouteContext<WorkspaceRoute> workspace;
    context RouteContext<InboxRoute> collection;
    context RouteContext<InboxNoteRoute> route;
    <Layout style={CollapsedRouteStateStyle} name={"notes.route." + workspace.Definition.Id.Value + "." + collection.Definition.Id.Value + "." + route.Parameters.Id.ToString("D")} />
}
