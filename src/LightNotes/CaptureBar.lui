namespace LightNotes;
style CaptureBarStyle(WindowBreakpoints breakpoints) {
    Background: LightNotesTheme.Canvas;
    Axis: LayoutAxis.Row;
    CrossAlignment: LayoutAlignment.Center;
    Spacing: 10;
    Height: 54;
    Padding: Insets.Symmetric(24, 8);
    Border: LightNotesTheme.DividerBottom;

    when (!breakpoints.IsActive(LightNotesBreakpoints.Wide)) {
        Padding: Insets.Symmetric(16, 8);
    }
}

style CaptureFieldStyle {
    CornerRadius: 6;
    Height: 38;
    MinWidth: 0;
    MainShrink: 1;
    Padding: Insets.Symmetric(11, 7);
    Background: LightNotesTheme.Field;
    TextColor: LightNotesTheme.Ink;
    MainGrow: 1;
    Border: LightNotesTheme.FieldOutline;
    when FocusVisible {
        Background: LightNotesTheme.Field;
        FocusRing: LightNotesTheme.KeyboardFocus;
    }
    when Disabled {
        Background: LightNotesTheme.Canvas;
        TextColor: LightNotesTheme.MutedInk;
    }
}

style PrimaryActionStyle {
    CornerRadius: 6;
    FontWeight: FontWeight.SemiBold;
    Width: 78;
    Height: 38;
    Padding: Insets.Symmetric(14, 7);
    MainAlignment: LayoutAlignment.Center;
    CrossAlignment: LayoutAlignment.Center;
    Background: LightNotesTheme.Accent;
    TextColor: LightNotesTheme.InverseInk;
    when Hover {
        Background: LightNotesTheme.AccentHover;
    }
    when Pressed {
        Background: LightNotesTheme.AccentPressed;
    }
    when FocusVisible {
        Background: LightNotesTheme.Accent;
        FocusRing: LightNotesTheme.KeyboardFocus;
    }
    when Disabled {
        Background: LightNotesTheme.Divider;
        TextColor: LightNotesTheme.MutedInk;
    }
}

public component CaptureBar(NoteWorkspace model) {
    <Layout style={CaptureBarStyle(model.Breakpoints)} name="notes.capture-bar">
        <TextField session={model.Capture} focusTarget={model.CaptureFocus} label="Capture a link or thought" style={CaptureFieldStyle with { Enabled: model.CanEdit; }} name="notes.capture" />
        <Button leadingIcon={Lucent.Icons.Lucide.LucideIcons.Plus} onInvoke={() => model.CaptureCommand.TryExecute()} style={PrimaryActionStyle with { Enabled: model.CaptureCommand.IsEnabled; }} name="notes.capture-action">Add</Button>
    </Layout>
}
