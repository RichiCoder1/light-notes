namespace LightNotes;
style EditorPaneStyle(WindowBreakpoints breakpoints, NoteWorkspace model) {
    Axis: LayoutAxis.Column;
    CrossAlignment: LayoutAlignment.Stretch;
    Background: LightNotesTheme.Canvas;
    MainGrow: 1;
    MainShrink: 1;
    MinWidth: 0;
    Clip: true;
    Padding: Insets.Symmetric(24, 22);
    Participation: ElementParticipation.Visible;

    when (!breakpoints.IsActive(LightNotesBreakpoints.Wide)) {
        Padding: Insets.Symmetric(16, 18);
    }

    when (!breakpoints.IsActive(LightNotesBreakpoints.Medium) && !model.ShowEditor) {
        Participation: ElementParticipation.Collapsed;
    }
}

style EditorContentStyle(NoteWorkspace model) {
    Axis: LayoutAxis.Column;
    CrossAlignment: LayoutAlignment.Stretch;
    MainGrow: 1;
    MainShrink: 1;
    Background: LightNotesTheme.Canvas;
    MinWidth: 0;
    MinHeight: 0;
    Spacing: 10;
    Clip: true;
    Participation: ElementParticipation.Collapsed;

    when (model.Selected.Value is not null) {
        Participation: ElementParticipation.Visible;
    }
}

style CompactEditorHeaderStyle(WindowBreakpoints breakpoints) {
    Height: 34;
    Background: LightNotesTheme.Canvas;
    Axis: LayoutAxis.Row;
    CrossAlignment: LayoutAlignment.Center;
    Spacing: 12;
    Participation: ElementParticipation.Collapsed;

    when (!breakpoints.IsActive(LightNotesBreakpoints.Medium)) {
        Participation: ElementParticipation.Visible;
    }
}

style EditorStatusIconStyle(WindowBreakpoints breakpoints) {
    Width: 16;
    Height: 16;
    MainShrink: 0;

    when (!breakpoints.IsActive(LightNotesBreakpoints.Medium)) {
        Participation: ElementParticipation.Collapsed;
    }
}

style UrlLeadingIconStyle {
    Width: 16;
    Height: 16;
    MainShrink: 0;
}

style BackActionStyle {
    CornerRadius: 5;
    Height: 32;
    Padding: Insets.Symmetric(8, 5);
    Background: LightNotesTheme.Canvas;
    TextColor: LightNotesTheme.AccentInk;
    when Hover {
        Background: LightNotesTheme.Hover;
    }
    when Pressed {
        Background: LightNotesTheme.SurfacePressed;
    }
    when FocusVisible {
        Background: LightNotesTheme.Canvas;
        FocusRing: LightNotesTheme.KeyboardFocus;
    }
}

style TitleFieldStyle {
    CornerRadius: 6;
    FontWeight: FontWeight.SemiBold;
    Height: 46;
    MinWidth: 0;
    MainShrink: 1;
    Padding: Insets.Symmetric(10, 9);
    Background: LightNotesTheme.Field;
    TextColor: LightNotesTheme.Ink;
    FontSize: 22;
    Border: LightNotesTheme.FieldOutline;
    when FocusVisible {
        Background: LightNotesTheme.Field;
        FocusRing: LightNotesTheme.KeyboardFocus;
    }
    when Disabled {
        Background: LightNotesTheme.Canvas;
        TextColor: LightNotesTheme.MutedInk;
    }
}

style UrlFieldStyle {
    CornerRadius: 6;
    Height: 38;
    MainGrow: 1;
    MinWidth: 0;
    MainShrink: 1;
    Padding: Insets.Symmetric(10, 7);
    Background: LightNotesTheme.Field;
    TextColor: LightNotesTheme.MutedInk;
    FontSize: 13;
    Border: LightNotesTheme.FieldOutline;
    when FocusVisible {
        Background: LightNotesTheme.Field;
        FocusRing: LightNotesTheme.KeyboardFocus;
    }
    when Disabled {
        Background: LightNotesTheme.Canvas;
        TextColor: LightNotesTheme.MutedInk;
    }
}

style BodyFieldStyle {
    CornerRadius: 6;
    Height: 160;
    MinWidth: 0;
    MainGrow: 1;
    MainShrink: 1;
    Padding: Insets.Symmetric(14, 14);
    Background: LightNotesTheme.Field;
    TextColor: LightNotesTheme.Ink;
    FontSize: 15;
    TextWrap: TextWrap.WordWithGraphemeFallback;
    Clip: true;
    Visibility: ScrollBarVisibility.Auto;
    Thickness: 10;
    MinimumThumbLength: 28;
    TrackBrush: LightNotesTheme.ScrollbarTrack;
    ThumbBrush: LightNotesTheme.ScrollbarThumb;
    HoverThumbBrush: LightNotesTheme.ScrollbarThumbHover;
    PressedThumbBrush: LightNotesTheme.ScrollbarThumbPressed;
    ThumbCornerRadius: 5;
    Border: LightNotesTheme.FieldOutline;
    when FocusVisible {
        Background: LightNotesTheme.Field;
        FocusRing: LightNotesTheme.KeyboardFocus;
    }
    when Disabled {
        Background: LightNotesTheme.Canvas;
        TextColor: LightNotesTheme.MutedInk;
    }
}

style FieldLabelStyle {
    FontWeight: FontWeight.Medium;
    FontSize: 12;
    TextColor: LightNotesTheme.MutedInk;
    Height: 18;
}

style UrlActionsStyle {
    Height: 38;
    Background: LightNotesTheme.Canvas;
    Axis: LayoutAxis.Row;
    CrossAlignment: LayoutAlignment.Center;
    Spacing: 8;
}

style EditorFooterStyle {
    Height: 38;
    Background: LightNotesTheme.Canvas;
    Axis: LayoutAxis.Row;
    CrossAlignment: LayoutAlignment.Center;
    Spacing: 8;
}

style EditorFooterStatusStyle(WindowBreakpoints breakpoints) {
    MainGrow: 1;
    MainShrink: 1;
    MinWidth: 0;
    FontSize: 12;
    TextColor: LightNotesTheme.MutedInk;
    MaxLines: 1;
    Overflow: TextOverflow.Ellipsis;

    when (!breakpoints.IsActive(LightNotesBreakpoints.Medium)) {
        Participation: ElementParticipation.Collapsed;
    }
}

style SaveStatusStyle {
    MainGrow: 1;
    MainShrink: 1;
    MinWidth: 0;
    FontSize: 12;
    TextColor: LightNotesTheme.MutedInk;
    MaxLines: 1;
    Overflow: TextOverflow.Ellipsis;
}

style QuietActionStyle {
    CornerRadius: 5;
    Height: 32;
    Padding: Insets.Symmetric(10, 6);
    Background: LightNotesTheme.Canvas;
    TextColor: LightNotesTheme.AccentInk;
    when Hover {
        Background: LightNotesTheme.Hover;
    }
    when Pressed {
        Background: LightNotesTheme.SurfacePressed;
    }
    when FocusVisible {
        Background: LightNotesTheme.Canvas;
        FocusRing: LightNotesTheme.KeyboardFocus;
    }
    when Disabled {
        Background: LightNotesTheme.Canvas;
        TextColor: LightNotesTheme.MutedInk;
    }
}

style ErrorStripStyle {
    Axis: LayoutAxis.Column;
    CornerRadius: 6;
    MinHeight: 54;
    Padding: Insets.Symmetric(12, 9);
    Spacing: 8;
    Background: LightNotesTheme.ErrorSurface;
    TextColor: LightNotesTheme.ErrorInk;
    Border: LightNotesTheme.ErrorOutline;
}

style EmptyEditorStyle(NoteWorkspace model) {
    Axis: LayoutAxis.Column;
    MainGrow: 1;
    Padding: Insets.Symmetric(12, 42);
    Spacing: 10;
    Participation: ElementParticipation.Collapsed;

    when (model.Selected.Value is null) {
        Participation: ElementParticipation.Visible;
    }
}

style EmptyEditorHeadingStyle {
    FontWeight: FontWeight.SemiBold;
    FontSize: 22;
    TextColor: LightNotesTheme.Ink;
}

style EmptyEditorBodyStyle {
    FontSize: 13;
    TextColor: LightNotesTheme.MutedInk;
    TextWrap: TextWrap.WordWithGraphemeFallback;
    MaxLines: 3;
    Overflow: TextOverflow.Ellipsis;
}

style EmptyEditorIconStyle {
    Width: 24;
    Height: 24;
    MainShrink: 0;
}

public component EditorPane(NoteWorkspace model) {
    <Layout style={EditorPaneStyle(model.Breakpoints, model)} name="notes.editor">
        <Layout style={EditorContentStyle(model)} name="notes.editor-content">
            <Layout style={CompactEditorHeaderStyle(model.Breakpoints)} name="notes.compact-editor-header">
                <Button leadingIcon={Lucent.Icons.Lucide.LucideIcons.ArrowLeft} onInvoke={() => model.BackToCollection()} style={BackActionStyle} name="notes.back">Back to collection</Button>
                <Status content={() => model.StatusText} style={SaveStatusStyle} name="notes.compact-status" />
            </Layout>
            <TextField session={model.Title} focusTarget={model.TitleFocus} label="Title" style={TitleFieldStyle with { Enabled: model.CanEdit; }} name="notes.title" />
            <Text style={FieldLabelStyle}>Web address (optional)</Text>
            <Layout style={UrlActionsStyle} name="notes.url-actions">
                <Icon source={Lucent.Icons.Lucide.LucideIcons.Link} style={UrlLeadingIconStyle} />
                <TextField session={model.Url} label="Web address" style={UrlFieldStyle with { Enabled: model.CanEdit; }} name="notes.url" />
                <Button leadingIcon={Lucent.Icons.Lucide.LucideIcons.ArrowRight} onInvoke={() => model.OpenLinkCommand.TryExecute()} style={QuietActionStyle with { Enabled: model.OpenLinkCommand.IsEnabled; }} name="notes.open-link">Open</Button>
            </Layout>
            <Text style={FieldLabelStyle}>Notes</Text>
            <TextArea session={model.Body} label="Notes" style={BodyFieldStyle with { Enabled: model.CanEdit; }} name="notes.body" />
            if (model.HasError) {
                <Layout style={ErrorStripStyle} name="notes.editor-error">
                    <Text>{model.ErrorHeading}</Text>
                    <Text content={() => model.ErrorMessage ?? "Your draft is still here."} style={Style.Empty.FontSize(12).TextWrap(TextWrap.WordWithGraphemeFallback).MaxLines(2).TextOverflow(TextOverflow.Ellipsis)} name="notes.editor-error-detail" />
                    <Button leadingIcon={Lucent.Icons.Lucide.LucideIcons.RefreshCw} onInvoke={() => model.RetryCommand.TryExecute()} style={QuietActionStyle with { Enabled: model.RetryCommand.IsEnabled; }} name="notes.editor-retry">Retry</Button>
                </Layout>
            }
            <Layout style={EditorFooterStyle} name="notes.editor-actions">
                <Icon source={() => model.HasError || model.HasValidationError ? Lucent.Icons.Lucide.LucideIcons.CircleDot : model.IsBusy || model.IsSaving || model.IsDirty ? Lucent.Icons.Lucide.LucideIcons.Ellipsis : Lucent.Icons.Lucide.LucideIcons.CircleCheck} style={EditorStatusIconStyle(model.Breakpoints)} />
                <Status content={() => model.StatusText} style={EditorFooterStatusStyle(model.Breakpoints)} name="notes.status" />
                if (model.HasValidationError && model.HasRecoveryDraft) {
                    <Button leadingIcon={Lucent.Icons.Lucide.LucideIcons.Trash} onInvoke={() => model.DiscardDraftCommand.TryExecute()} style={QuietActionStyle with { Enabled: model.DiscardDraftCommand.IsEnabled; }} name="notes.discard-draft">Discard draft</Button>
                } else {
                    <Button onInvoke={() => model.SaveCommand.TryExecute()} style={QuietActionStyle with { Enabled: model.SaveCommand.IsEnabled; }} name="notes.save">Save now</Button>
                }
                <Button leadingIcon={Lucent.Icons.Lucide.LucideIcons.Archive} onInvoke={() => model.ArchiveCommand.TryExecute()} style={QuietActionStyle with { Enabled: model.ArchiveCommand.IsEnabled; Participation: model.ShowArchived.Value ? ElementParticipation.Visible : ElementParticipation.Collapsed; }} name="notes.restore">Restore</Button>
                <Button leadingIcon={Lucent.Icons.Lucide.LucideIcons.Archive} onInvoke={() => model.ArchiveCommand.TryExecute()} style={QuietActionStyle with { Enabled: model.ArchiveCommand.IsEnabled; Participation: !model.ShowArchived.Value ? ElementParticipation.Visible : ElementParticipation.Collapsed; }} name="notes.archive">Archive</Button>
                <Button onInvoke={() => model.BackupCommand.TryExecute()} style={QuietActionStyle with { Enabled: model.BackupCommand.IsEnabled; }} name="notes.backup">Backup</Button>
            </Layout>
        </Layout>
        <Layout style={EmptyEditorStyle(model)} name="notes.editor-empty">
            <Icon source={Lucent.Icons.Lucide.LucideIcons.FileText} style={EmptyEditorIconStyle} />
            <Text style={EmptyEditorHeadingStyle}>Select an item</Text>
            <Text style={EmptyEditorBodyStyle}>Choose a saved note from the list, or capture a link or thought above.</Text>
        </Layout>
    </Layout>
}
