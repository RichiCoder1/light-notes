using LightNotes.Storage;
namespace LightNotes;

style NoteMenuStyle {
    Background: LightNotesTheme.Surface;
    TextColor: LightNotesTheme.Ink;
}

public component NoteMenu(NoteWorkspace model, NoteRecord note) {
    <Menu style={NoteMenuStyle}>
        <MenuItem onInvoke={() => model.Open(note.Id)} enabled={() => model.CanRunCommands}>
            Open note
        </MenuItem>
        <MenuItem
            onInvoke={() => model.OpenRecordLink(note.Id)}
            enabled={() => model.CanRunCommands && model.CanOpenRecordLink(note.Id)}
        >
            Open web address
        </MenuItem>
        <MenuSeparator />
        <MenuItem
            onInvoke={() => model.SetArchived(note.Id, !note.IsArchived)}
            enabled={() => model.CanRunCommands}
        >
            {note.IsArchived ? "Restore to Inbox" : "Archive"}
        </MenuItem>
    </Menu>
}
