using LightNotes.Storage;
namespace LightNotes;
style NoteRowStyle {
    Axis: LayoutAxis.Column;
    CrossAlignment: LayoutAlignment.Stretch;
    Spacing: 4;
    Height: 72;
    MinWidth: 0;
    MainShrink: 1;
    Padding: Insets.Symmetric(12, 9);
    Background: LightNotesTheme.Surface;
    TextColor: LightNotesTheme.Ink;
    FontSize: 13;
    TextWrap: TextWrap.WordWithGraphemeFallback;
    MaxLines: 3;
    Overflow: TextOverflow.Ellipsis;
    when Hover {
        Background: LightNotesTheme.Hover;
    }
    when Selected {
        Border: LightNotesTheme.RowSelectionOutline;
        Background: LightNotesTheme.Selection;
    }
    when FocusVisible {
        Background: LightNotesTheme.Selection;
        FocusRing: LightNotesTheme.KeyboardFocus;
    }
}

style NoteRowTitleStyle {
    MainGrow: 1;
    MainShrink: 1;
    MinHeight: 0;
    MinWidth: 0;
    FontSize: 14;
    FontWeight: FontWeight.SemiBold;
    TextColor: LightNotesTheme.Ink;
    TextWrap: TextWrap.WordWithGraphemeFallback;
    MaxLines: 2;
    Overflow: TextOverflow.Ellipsis;
}

style NoteRowMetadataStyle {
    Height: 16;
    MinWidth: 0;
    FontSize: 11;
    TextColor: LightNotesTheme.MutedInk;
    MaxLines: 1;
    Overflow: TextOverflow.Ellipsis;
}

public component NoteRow(NoteWorkspace model, Func<NoteRecord> item) {
    <Selectable
        label={() => NotePresentation.RowLabel(item())}
        selected={() => model.Selected.Value != null && model.Selected.Value.Id == item().Id}
        onSelect={() => model.Select(item().Id)}
        style={NoteRowStyle}
        name="notes.row">
        <Text style={NoteRowTitleStyle}>{NotePresentation.RowTitle(item())}</Text>
        <Text style={NoteRowMetadataStyle}>{NotePresentation.RowMetadata(item())}</Text>
    </Selectable>
}
