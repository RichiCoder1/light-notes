using LightNotes.Storage;
namespace LightNotes;
style NoteRowStyle {
    Height: 72;
    MinWidth: 0;
    MainShrink: 1;
    Padding: Insets.Symmetric(12, 9);
    Background: LightNotesTheme.Surface;
    TextColor: LightNotesTheme.Ink;
    FontSize: 13;
    TextWrap: TextWrap.WordWithGraphemeFallback;
    MaxLines: 3;
    Overflow: TextOverflow.Ellipsis;
    Border: LightNotesTheme.DividerBottom;
    when Hover {
        Background: LightNotesTheme.Hover;
    }
    when Selected {
        Background: LightNotesTheme.Selection;
    }
    when FocusVisible {
        Background: LightNotesTheme.Selection;
        FocusRing: LightNotesTheme.KeyboardFocus;
    }
}

public component NoteRow(NoteWorkspace model, Func<NoteRecord> item) {
    <Selectable
        selected={() => model.Selected.Value != null && model.Selected.Value.Id == item().Id}
        onSelect={() => model.Select(item().Id)}
        style={NoteRowStyle}
        name="notes.row">
        {() => NotePresentation.RowLabel(item())}
    </Selectable>
}
