namespace LightNotes;
style CollectionPaneStyle {
    CrossAlignment: LayoutAlignment.Stretch;
    Background: LightNotesTheme.Surface;
    MainGrow: 0;
    MainShrink: 0;
    Clip: true;
    Padding: Insets.Symmetric(16, 18);
    Spacing: 14;
    Border: LightNotesTheme.DividerRight;
}

style CollectionHeaderStyle {
    Axis: LayoutAxis.Row;
    Height: 32;
    CrossAlignment: LayoutAlignment.Center;
    Spacing: 10;
}

style CollectionTitleStyle {
    FontWeight: FontWeight.SemiBold;
    MainGrow: 1;
    MainShrink: 1;
    MinWidth: 0;
    FontSize: 20;
    TextColor: LightNotesTheme.Ink;
    MaxLines: 1;
    Overflow: TextOverflow.Ellipsis;
}

style CollectionCountStyle {
    FontSize: 12;
    TextColor: LightNotesTheme.MutedInk;
    MaxLines: 1;
}

style CompactDestinationStyle {
    CornerRadius: 5;
    Height: 30;
    Padding: Insets.Symmetric(7, 5);
    Background: LightNotesTheme.Surface;
    TextColor: LightNotesTheme.AccentInk;
    FontSize: 12;
    when Hover {
        Background: LightNotesTheme.Hover;
    }
    when Pressed {
        Background: LightNotesTheme.SurfacePressed;
    }
    when FocusVisible {
        Background: LightNotesTheme.Surface;
        FocusRing: LightNotesTheme.KeyboardFocus;
    }
}

style SearchFieldStyle {
    CornerRadius: 6;
    Height: 38;
    MinWidth: 0;
    MainShrink: 1;
    Padding: Insets.Symmetric(10, 8);
    Background: LightNotesTheme.Field;
    TextColor: LightNotesTheme.Ink;
    Border: LightNotesTheme.FieldOutline;
    when FocusVisible {
        Background: LightNotesTheme.Field;
        FocusRing: LightNotesTheme.KeyboardFocus;
    }
    when Disabled {
        Background: LightNotesTheme.Field;
        TextColor: LightNotesTheme.MutedInk;
    }
}

style ClearSearchStyle {
    CornerRadius: 5;
    Height: 30;
    Padding: Insets.Symmetric(8, 5);
    Background: LightNotesTheme.Surface;
    TextColor: LightNotesTheme.AccentInk;
    when Hover {
        Background: LightNotesTheme.Hover;
    }
    when Pressed {
        Background: LightNotesTheme.SurfacePressed;
    }
    when FocusVisible {
        Background: LightNotesTheme.Surface;
        FocusRing: LightNotesTheme.KeyboardFocus;
    }
}

style CollectionListStyle {
    Height: 180;
    MinWidth: 0;
    MainGrow: 1;
    MainShrink: 1;
    MinHeight: 0;
    Clip: true;
    Visibility: ScrollBarVisibility.Auto;
    Thickness: 10;
    MinimumThumbLength: 28;
    TrackBrush: LightNotesTheme.ScrollbarTrack;
    ThumbBrush: LightNotesTheme.ScrollbarThumb;
    HoverThumbBrush: LightNotesTheme.ScrollbarThumbHover;
    PressedThumbBrush: LightNotesTheme.ScrollbarThumbPressed;
    ThumbCornerRadius: 5;
    Background: LightNotesTheme.Surface;
}

public component CollectionPane(NoteWorkspace model) {
    bool compact = model.IsCompact;
    float? paneWidth = compact ? null : model.IsWide ? 320f : 300f;
    float paneFlex = compact ? 1f : 0f;
    ElementParticipation paneParticipation = !compact || model.ShowCollection ? ElementParticipation.Visible : ElementParticipation.Collapsed;
    bool hasQuery = model.Search.Text.Length != 0;
    bool showList = model.IsReady && model.VisibleItems.Count != 0;
    void ClearSearch() => model.Search.Text = string.Empty;
    <Column style={CollectionPaneStyle with { Width: paneWidth; MainGrow: paneFlex; MainShrink: paneFlex; Participation: paneParticipation; }} name="notes.collection">
        <Row style={CollectionHeaderStyle} name="notes.collection-header">
            <Text content={() => model.ShowArchived.Value ? "Archive" : "Inbox"} style={CollectionTitleStyle} name="notes.collection-title" />
            <Text content={() => NotePresentation.CollectionCount(model)} style={CollectionCountStyle with { Participation: compact ? ElementParticipation.Collapsed : ElementParticipation.Visible; }} name="notes.collection-count" />
            <Button onInvoke={() => model.ShowInbox()} style={CompactDestinationStyle with { Participation: compact && model.ShowArchived.Value ? ElementParticipation.Visible : ElementParticipation.Collapsed; }} name="notes.compact-inbox">Inbox</Button>
            <Button onInvoke={() => model.ShowArchive()} style={CompactDestinationStyle with { Participation: compact && !model.ShowArchived.Value ? ElementParticipation.Visible : ElementParticipation.Collapsed; }} name="notes.compact-archive">Archive</Button>
        </Row>
        <TextField session={model.Search} focusTarget={model.SearchFocus} label="Search saved items" style={SearchFieldStyle with { Enabled: model.CanSearch; }} name="notes.search" />
        if (hasQuery) {
            <Row style={Style.Empty.Height(30).MainAlignment(LayoutAlignment.End)} name="notes.search-actions">
                <Button onInvoke={ClearSearch} style={ClearSearchStyle} name="notes.clear-search">Clear search</Button>
            </Row>
        }
        <CollectionLoading model={model} />
        <CollectionError model={model} />
        <CollectionEmpty model={model} clearSearch={ClearSearch} />
        <VirtualizedList source={() => model.VisibleItems} key={item => item.Id} row={item => NoteRow(model, () => item.Value)} rowHeight={() => 72f} label="Saved notes" viewport={model.CollectionViewport} style={CollectionListStyle with { Participation: showList ? ElementParticipation.Visible : ElementParticipation.Collapsed; }} name="notes.list" />
    </Column>
}
