namespace LightNotes;
style CollectionPaneStyle(WindowBreakpoints breakpoints, NoteWorkspace model) {
    Axis: LayoutAxis.Column;
    CrossAlignment: LayoutAlignment.Stretch;
    Background: LightNotesTheme.Surface;
    MainGrow: 0;
    MainShrink: 0;
    Width: 320;
    Participation: ElementParticipation.Visible;
    Clip: true;
    Padding: Insets.Symmetric(16, 18);
    Spacing: 14;
    Border: LightNotesTheme.DividerRight;

    when (!breakpoints.IsActive(LightNotesBreakpoints.Wide) && breakpoints.IsActive(LightNotesBreakpoints.Medium)) {
        Width: 300;
    }

    when (!breakpoints.IsActive(LightNotesBreakpoints.Medium) && model.ShowCollection) {
        Width: null;
        MainGrow: 1;
        MainShrink: 1;
    }

    when (!breakpoints.IsActive(LightNotesBreakpoints.Medium) && !model.ShowCollection) {
        Participation: ElementParticipation.Collapsed;
    }
}

style CollectionHeaderStyle {
    Axis: LayoutAxis.Row;
    Height: 32;
    CrossAlignment: LayoutAlignment.Center;
    Spacing: 10;
}

style CollectionTitleStyle {
    FontWeight: FontWeight.SemiBold;
    MainGrow: 1;
    MainShrink: 1;
    MinWidth: 0;
    FontSize: 20;
    TextColor: LightNotesTheme.Ink;
    MaxLines: 1;
    Overflow: TextOverflow.Ellipsis;
}

style CollectionCountStyle(WindowBreakpoints breakpoints) {
    FontSize: 12;
    TextColor: LightNotesTheme.MutedInk;
    MaxLines: 1;

    when (!breakpoints.IsActive(LightNotesBreakpoints.Medium)) {
        Participation: ElementParticipation.Collapsed;
    }
}

style SearchActionsStyle {
    Axis: LayoutAxis.Row;
    Height: 30;
    MainAlignment: LayoutAlignment.End;
}

style CompactInboxStyle(WindowBreakpoints breakpoints, NoteWorkspace model) {
    CornerRadius: 5;
    Height: 30;
    Padding: Insets.Symmetric(7, 5);
    Background: LightNotesTheme.Surface;
    TextColor: LightNotesTheme.AccentInk;
    FontSize: 12;
    when Hover {
        Background: LightNotesTheme.Hover;
    }
    when Pressed {
        Background: LightNotesTheme.SurfacePressed;
    }
    when FocusVisible {
        Background: LightNotesTheme.Surface;
        FocusRing: LightNotesTheme.KeyboardFocus;
    }

    Participation: ElementParticipation.Collapsed;
    when (!breakpoints.IsActive(LightNotesBreakpoints.Medium) && model.ShowArchived.Value) {
        Participation: ElementParticipation.Visible;
    }
}

style CompactArchiveStyle(WindowBreakpoints breakpoints, NoteWorkspace model) {
    CornerRadius: 5;
    Height: 30;
    Padding: Insets.Symmetric(7, 5);
    Background: LightNotesTheme.Surface;
    TextColor: LightNotesTheme.AccentInk;
    FontSize: 12;
    when Hover {
        Background: LightNotesTheme.Hover;
    }
    when Pressed {
        Background: LightNotesTheme.SurfacePressed;
    }
    when FocusVisible {
        Background: LightNotesTheme.Surface;
        FocusRing: LightNotesTheme.KeyboardFocus;
    }

    Participation: ElementParticipation.Collapsed;
    when (!breakpoints.IsActive(LightNotesBreakpoints.Medium) && !model.ShowArchived.Value) {
        Participation: ElementParticipation.Visible;
    }
}

style SearchFieldStyle {
    CornerRadius: 6;
    Height: 38;
    MinWidth: 0;
    MainShrink: 1;
    Padding: Insets.Symmetric(10, 8);
    Background: LightNotesTheme.Field;
    TextColor: LightNotesTheme.Ink;
    Border: LightNotesTheme.FieldOutline;
    when FocusVisible {
        Background: LightNotesTheme.Field;
        FocusRing: LightNotesTheme.KeyboardFocus;
    }
    when Disabled {
        Background: LightNotesTheme.Field;
        TextColor: LightNotesTheme.MutedInk;
    }
}

style ClearSearchStyle {
    CornerRadius: 5;
    Height: 30;
    Padding: Insets.Symmetric(8, 5);
    Background: LightNotesTheme.Surface;
    TextColor: LightNotesTheme.AccentInk;
    when Hover {
        Background: LightNotesTheme.Hover;
    }
    when Pressed {
        Background: LightNotesTheme.SurfacePressed;
    }
    when FocusVisible {
        Background: LightNotesTheme.Surface;
        FocusRing: LightNotesTheme.KeyboardFocus;
    }
}

style CollectionListStyle(NoteWorkspace model) {
    Height: 180;
    MinWidth: 0;
    MainGrow: 1;
    MainShrink: 1;
    MinHeight: 0;
    Clip: true;
    Visibility: ScrollBarVisibility.Auto;
    Thickness: 10;
    MinimumThumbLength: 28;
    TrackBrush: LightNotesTheme.ScrollbarTrack;
    ThumbBrush: LightNotesTheme.ScrollbarThumb;
    HoverThumbBrush: LightNotesTheme.ScrollbarThumbHover;
    PressedThumbBrush: LightNotesTheme.ScrollbarThumbPressed;
    ThumbCornerRadius: 5;
    Background: LightNotesTheme.Surface;

    Participation: ElementParticipation.Collapsed;
    when (model.IsReady && model.VisibleItems.Count != 0) {
        Participation: ElementParticipation.Visible;
    }
}

public component CollectionPane(NoteWorkspace model) {
    bool hasQuery = model.Search.Text.Length != 0;
    void ClearSearch() => model.Search.Text = string.Empty;
    <Layout style={CollectionPaneStyle(model.Breakpoints, model)} name="notes.collection">
        <Layout style={CollectionHeaderStyle} name="notes.collection-header">
            <Text content={() => model.ShowArchived.Value ? "Archive" : "Inbox"} style={CollectionTitleStyle} name="notes.collection-title" />
            <Text content={() => NotePresentation.CollectionCount(model)} style={CollectionCountStyle(model.Breakpoints)} name="notes.collection-count" />
            <Button onInvoke={() => model.ShowInbox()} style={CompactInboxStyle(model.Breakpoints, model)} name="notes.compact-inbox">Inbox</Button>
            <Button onInvoke={() => model.ShowArchive()} style={CompactArchiveStyle(model.Breakpoints, model)} name="notes.compact-archive">Archive</Button>
        </Layout>
        <TextField session={model.Search} focusTarget={model.SearchFocus} label="Search saved items" style={SearchFieldStyle with { Enabled: model.CanSearch; }} name="notes.search" />
        if (hasQuery) {
            <Layout style={SearchActionsStyle} name="notes.search-actions">
                <Button onInvoke={ClearSearch} style={ClearSearchStyle} name="notes.clear-search">Clear search</Button>
            </Layout>
        }
        <CollectionLoading model={model} />
        <CollectionError model={model} />
        <CollectionEmpty model={model} clearSearch={ClearSearch} />
        <VirtualizedList source={() => model.VisibleItems} key={item => item.Id} row={item => NoteRow(model, () => item.Value)} rowHeight={() => 72f} label="Saved notes" viewport={model.CollectionViewport} style={CollectionListStyle(model)} name="notes.list" />
    </Layout>
}
