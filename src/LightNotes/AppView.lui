namespace LightNotes;
style ShellStyle {
    CrossAlignment: LayoutAlignment.Stretch;
    Background: LightNotesTheme.Canvas;
    TextColor: LightNotesTheme.Ink;
    FontFamily: "Segoe UI";
    FontSize: 14;
    MainGrow: 1;
    MinWidth: 0;
    MinHeight: 0;
    Clip: true;
}

style WorkspaceStyle {
    Axis: LayoutAxis.Row;
    CrossAlignment: LayoutAlignment.Stretch;
    MainGrow: 1;
    MinWidth: 0;
    MinHeight: 0;
    Clip: true;
    Background: LightNotesTheme.Surface;
}

internal component AppView(NoteWorkspace model) {
    <CommandScope bindings={model.Bindings}>
        <ResponsiveContainer constraints={model.Constraints} style={ShellStyle}>
            <Column style={ShellStyle} name="notes.shell">
                <CaptureBar model={model} />
                <Row style={WorkspaceStyle} name="notes.workspace">
                    <Navigation model={model} />
                    <CollectionPane model={model} />
                    <EditorPane model={model} />
                </Row>
            </Column>
        </ResponsiveContainer>
    </CommandScope>
}
