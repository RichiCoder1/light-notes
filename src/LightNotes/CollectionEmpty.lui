namespace LightNotes;
style EmptyCollectionPanelStyle {
    Axis: LayoutAxis.Column;
    MainGrow: 1;
    Padding: Insets.Symmetric(8, 30);
    Spacing: 10;
    Background: LightNotesTheme.Surface;
}

style EmptyCollectionHeadingStyle {
    FontWeight: FontWeight.SemiBold;
    FontSize: 18;
    TextColor: LightNotesTheme.Ink;
    TextWrap: TextWrap.WordWithGraphemeFallback;
    MaxLines: 2;
    Overflow: TextOverflow.Ellipsis;
}

style EmptyCollectionBodyStyle {
    FontSize: 13;
    TextColor: LightNotesTheme.MutedInk;
    TextWrap: TextWrap.WordWithGraphemeFallback;
    MaxLines: 3;
    Overflow: TextOverflow.Ellipsis;
}

style EmptyCollectionActionStyle {
    CornerRadius: 5;
    Height: 30;
    Padding: Insets.Symmetric(8, 5);
    Background: LightNotesTheme.Surface;
    TextColor: LightNotesTheme.AccentInk;
    when Hover {
        Background: LightNotesTheme.Hover;
    }
    when Pressed {
        Background: LightNotesTheme.SurfacePressed;
    }
    when FocusVisible {
        FocusRing: LightNotesTheme.KeyboardFocus;
    }
}

style EmptyCollectionIconStyle {
    Width: 22;
    Height: 22;
    MainShrink: 0;
}

public component CollectionEmpty(NoteWorkspace model, Action clearSearch) {
    <Layout style={EmptyCollectionPanelStyle with { Participation: model.IsReady && model.VisibleItems.Count == 0 ? ElementParticipation.Visible : ElementParticipation.Collapsed; }} name="notes.collection-empty">
        <Icon source={Lucent.Icons.Lucide.LucideIcons.Search} style={EmptyCollectionIconStyle with { Participation: model.Search.Text.Length != 0 ? ElementParticipation.Visible : ElementParticipation.Collapsed; }} />
        <Text content={() => NotePresentation.EmptyHeading(model)} style={EmptyCollectionHeadingStyle} name="notes.collection-empty-title" />
        <Text content={() => NotePresentation.EmptyGuidance(model)} style={EmptyCollectionBodyStyle} name="notes.collection-empty-guidance" />
        if (model.Search.Text.Length != 0) {
            <Button onInvoke={clearSearch} style={EmptyCollectionActionStyle} name="notes.collection-empty-clear">Clear search</Button>
        }
    </Layout>
}
